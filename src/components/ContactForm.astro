---
import { site } from '../data/site';
const field = 'mt-1 w-full rounded-xl bg-surface border border-white/10 px-4 py-3 text-text placeholder:text-muted focus:outline-none focus:border-accent';
---
<form id="contact-form" action={site.formEndpoint} method="POST" class="grid gap-4">
  <div class="grid gap-4 md:grid-cols-2">
    <label class="text-sm text-muted">Name
      <input class={field} type="text" name="name" required maxlength="100" autocomplete="name" />
    </label>
    <label class="text-sm text-muted">Email
      <input class={field} type="email" name="email" required maxlength="200" autocomplete="email" />
    </label>
  </div>
  <label class="text-sm text-muted">Project details
    <textarea class={field} name="message" rows="5" required maxlength="5000" placeholder="What are you building, and what's your timeline?"></textarea>
  </label>
  <!-- Honeypot: hidden from people, bots fill it in -->
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
  <button type="submit" class="rounded-full bg-accent px-6 py-3 font-medium text-bg hover:opacity-90 disabled:opacity-50">Send message</button>
  <p id="form-status" role="status" aria-live="polite" class="text-sm min-h-5"></p>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button') as HTMLButtonElement;
    btn.disabled = true;
    status!.className = 'text-sm min-h-5 text-muted';
    status!.textContent = 'Sending…';
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error();
      form.reset();
      status!.className = 'text-sm min-h-5 text-green-400';
      status!.textContent = "Thanks! Your message was sent. We'll reply within a day.";
    } catch {
      status!.className = 'text-sm min-h-5 text-red-400';
      status!.textContent = 'Something went wrong. Please email us directly instead.';
    } finally {
      btn.disabled = false;
    }
  });
</script>
