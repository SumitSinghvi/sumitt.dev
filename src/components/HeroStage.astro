---
import OrdersMock from './OrdersMock.astro';
---
<div class="relative mx-auto mt-14 max-w-5xl px-2 md:px-10" style="perspective: 1800px">
  <div class="reveal">
    <div class="md:[transform:rotateX(7deg)_rotateY(-9deg)_rotateZ(1deg)] [transform-style:preserve-3d] rounded-2xl">
      <OrdersMock bare />
    </div>
  </div>

  <!-- Floating cards (decorative, illustrative) -->
  <div class="float hidden md:flex absolute -left-2 bottom-10 items-center gap-3 card px-4 py-3">
    <span class="grid h-9 w-9 place-items-center rounded-lg bg-tint text-accent-ink">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg>
    </span>
    <span class="text-left leading-tight">
      <b class="block text-sm font-semibold">Challan NW-1042</b>
      <span class="text-xs text-muted">PDF ready ·</span> <span class="text-xs font-semibold text-[#14803c]">Share on WhatsApp</span>
    </span>
  </div>

  <div class="float-2 hidden md:block absolute -right-3 -top-8 card p-3 w-44">
    <p class="text-xs font-semibold">Team on map</p>
    <div class="relative mt-2 h-20 rounded-lg overflow-hidden" style="background: radial-gradient(circle at 30% 40%, #fff3dc, #f1ead9); background-image: radial-gradient(rgb(29 25 18 / .12) 1px, transparent 1px); background-size: 10px 10px;">
      <i class="absolute left-[22%] top-[30%] h-2.5 w-2.5 rounded-full bg-accent" style="animation: ping 2s infinite"></i>
      <i class="absolute left-[55%] top-[55%] h-2.5 w-2.5 rounded-full bg-accent" style="animation: ping 2.4s infinite"></i>
      <i class="absolute left-[78%] top-[25%] h-2.5 w-2.5 rounded-full bg-accent" style="animation: ping 2.8s infinite"></i>
      <i class="absolute left-[40%] top-[75%] h-2.5 w-2.5 rounded-full bg-ink"></i>
    </div>
    <p class="mt-2 text-[11px] text-muted">4 reps live</p>
  </div>

  <div class="float-3 hidden md:flex absolute right-6 bottom-2 items-center gap-2 card px-4 py-2.5 text-sm">
    <span class="grid h-5 w-5 place-items-center rounded-full bg-[#dcfce7] text-[#14803c] text-xs">✓</span>
    <span><b class="font-semibold">Back online</b> · 3 orders synced</span>
  </div>
  <p class="mt-6 text-center text-xs text-muted">Illustrative interface drawn with sample data</p>
</div>
