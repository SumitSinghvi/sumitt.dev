---
import { orbit } from '../data/site';
const n = orbit.length;
const pts = orbit.map((label, i) => {
  const a = (-90 + (360 / n) * i) * (Math.PI / 180);
  return { label, left: 50 + 40 * Math.cos(a), top: 50 + 38 * Math.sin(a) };
});
---
<div class="relative mx-auto mt-12 hidden md:block aspect-[16/8] max-w-4xl rounded-3xl overflow-hidden"
     style="background: radial-gradient(circle at 50% 50%, rgb(245 166 35 / .22), transparent 62%), #fff; border: 1px solid var(--color-line);">
  <i class="absolute inset-[8%] rounded-full border border-accent/25"></i>
  <i class="absolute inset-[22%] rounded-full border border-accent/30"></i>
  <i class="absolute inset-[36%] rounded-full border border-accent/40"></i>
  <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 grid h-20 w-20 place-items-center rounded-full bg-ink shadow-xl">
    <span class="grid h-12 w-12 place-items-center rounded-full bg-accent text-ink text-xl font-bold">S</span>
  </div>
  {pts.map((p) => (
    <span class="absolute -translate-x-1/2 -translate-y-1/2 card !rounded-full px-4 py-2 text-sm font-medium whitespace-nowrap flex items-center gap-2"
          style={`left:${p.left}%; top:${p.top}%`}>
      <i class="h-2 w-2 rounded-full bg-accent"></i>{p.label}
    </span>
  ))}
</div>
<ul class="md:hidden mt-10 flex flex-wrap justify-center gap-3">
  {orbit.map((l) => <li class="card !rounded-full px-4 py-2 text-sm flex items-center gap-2"><i class="h-2 w-2 rounded-full bg-accent"></i>{l}</li>)}
</ul>
