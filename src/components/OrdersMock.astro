---
// Illustrative UI drawn in HTML/CSS with made-up sample data (no client information).
const rows = [
  { id: 'NW-1042', party: 'Sample Traders', items: ['Quality A 58" · 4,800m'], amount: '₹3,31,200', status: 'Pending' },
  { id: 'TM-1041', party: 'Demo Fabrics', items: ['Print 58" (Top) · 1,440m', 'Print 58" (Bottom) · 1,440m'], amount: '₹2,39,040', status: 'Confirmed' },
  { id: 'NW-1040', party: 'Example Textiles', items: ['Quality B 58" · 960m'], amount: '₹66,720', status: 'Dispatched' },
  { id: 'RR-1039', party: 'Test Creation', items: ['Quality A 58" (Top) · 1,920m', 'Quality A 58" (Bottom) · 1,152m'], amount: '₹2,11,968', status: 'Pending' },
];
const { bare = false } = Astro.props;
const tone: Record<string, string> = { Pending: 'p', Confirmed: 'c', Dispatched: 'd' };
---
<div class:list={["mock", { bare }]} role="img" aria-label="Illustration of the live orders dashboard, drawn with sample data">
  <div class="win">
    <div class="bar"><i></i><i></i><i></i><span>app.example / live-orders</span><small>Illustrative UI · sample data</small></div>
    <div class="body">
      <aside>
        <b class="logo"></b>
        <u class="on">Live Orders <em>16</em></u><u>Dispatch</u><u>Create Order</u><u>Daily Beat Plan</u><u>Field Tracking</u>
      </aside>
      <main>
        <div class="top"><h4>Live Orders Pipeline</h4><span class="btn">+ Book Order</span></div>
        <div class="chips"><span class="on">ALL</span><span>PENDING</span><span>CONFIRMED</span><span>DISPATCHED</span><span>DELIVERED</span></div>
        <div class="head"><span>Order</span><span>Buyer</span><span>Items</span><span>Amount</span><span>Status</span></div>
        {rows.map((r) => (
          <div class="row">
            <span class="id">{r.id}</span>
            <span class="party">{r.party}</span>
            <span class="items">{r.items.map((i) => <em>{i}</em>)}</span>
            <span class="amt">{r.amount}</span>
            <span class={`pill ${tone[r.status]}`}>{r.status}</span>
          </div>
        ))}
      </main>
    </div>
  </div>
</div>

<style>
  .mock { container-type: inline-size; width: 100%; height: 100%; background: linear-gradient(135deg, #fff3dc, #ffd9a0); display: grid; place-items: center; overflow: hidden; }
  .mock.bare { background: transparent; }
  .mock.bare .win { width: 100%; }
  .win { width: 92%; font-size: 1.55cqw; background: #fff; color: #111827; border-radius: .9em; overflow: hidden; box-shadow: 0 1.5em 3em rgba(120,70,0,.22); font-family: ui-sans-serif, system-ui, sans-serif; }
  .bar { display: flex; align-items: center; gap: .5em; padding: .6em .9em; background: #eef0f4; border-bottom: 1px solid #e1e4ea; }
  .bar i { width: .8em; height: .8em; border-radius: 50%; background: #c9ced8; }
  .bar span { margin-left: .8em; font-size: .85em; color: #6b7280; }
  .bar small { margin-left: auto; font-size: .7em; color: #9aa1af; }
  .body { display: grid; grid-template-columns: 9em 1fr; }
  aside { background: #1d1912; color: #aab3c5; padding: 1em .8em; display: grid; align-content: start; gap: .55em; font-size: .85em; }
  aside u { text-decoration: none; padding: .45em .6em; border-radius: .5em; display: flex; justify-content: space-between; }
  aside u.on { background: #2c261a; color: #fff; }
  aside em { font-style: normal; background: #f59e0b; color: #111; border-radius: 1em; padding: 0 .5em; font-weight: 700; }
  .logo { height: 2.6em; border-radius: .6em; background: linear-gradient(135deg, #f5b342, #e07a3a); margin-bottom: .6em; }
  main { padding: 1em 1.1em 1.2em; display: grid; gap: .7em; }
  .top { display: flex; justify-content: space-between; align-items: center; }
  h4 { margin: 0; font-size: 1.25em; font-weight: 700; }
  .btn { background: #111827; color: #fff; padding: .45em .9em; border-radius: .6em; font-size: .85em; font-weight: 600; }
  .chips { display: flex; gap: .5em; font-size: .72em; font-weight: 600; color: #6b7280; }
  .chips span { line-height: 1.3; padding: .4em .8em; border-radius: 1em; background: #f1f3f7; }
  .chips .on { background: #111827; color: #fff; }
  .head, .row { display: grid; grid-template-columns: 5.2em 8em 1fr 6em 5.8em; gap: .8em; align-items: center; }
  .head { font-size: .68em; letter-spacing: .06em; text-transform: uppercase; color: #9aa1af; padding: .2em 0; border-bottom: 1px solid #e5e7eb; }
  .row { padding: .55em 0; border-bottom: 1px solid #f0f1f4; font-size: .85em; }
  .id { font-family: ui-monospace, monospace; font-weight: 700; font-size: .9em; }
  .party { font-weight: 600; }
  .items { display: grid; gap: .3em; }
  .items em { font-style: normal; font-size: .8em; background: #f3f4f6; border-radius: .4em; padding: .25em .5em; width: fit-content; }
  .amt { font-weight: 700; text-align: right; font-family: ui-monospace, monospace; }
  .pill { font-size: .72em; font-weight: 700; text-align: center; border-radius: 1em; padding: .35em .6em; }
  .pill.p { background: #fef3c7; color: #b45309; }
  .pill.c { background: #dbeafe; color: #1d4ed8; }
  .pill.d { background: #dcfce7; color: #15803d; }
</style>
