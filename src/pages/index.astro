---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, services, projects } from '../data/site';
---
<Base>
  <Header />
  <main>
    <section class="mx-auto max-w-6xl px-5 pt-24 pb-28">
      <h1 class="reveal text-5xl md:text-7xl font-bold tracking-tight max-w-3xl">
        {site.tagline}
      </h1>
      <p class="reveal mt-6 max-w-xl text-lg text-muted">
        {site.description}
      </p>
      <div class="reveal mt-10 flex gap-4">
        <a href={site.booking} target="_blank" rel="noopener" class="rounded-full bg-accent px-6 py-3 font-medium text-bg hover:opacity-90">Book a call</a>
        <a href="#work" class="rounded-full border border-white/15 px-6 py-3 hover:bg-white/5">See my work</a>
      </div>
    </section>

    <section id="work" class="mx-auto max-w-6xl px-5 py-20">
      <h2 class="text-3xl font-semibold mb-10">Selected work</h2>
      <div class="grid gap-6 [grid-template-columns:repeat(auto-fill,minmax(18rem,26rem))]">
        {projects.map((p) => {
          const Tag = p.url ? 'a' : 'div';
          return (
            <Tag {...(p.url ? { href: p.url, target: '_blank', rel: 'noopener' } : {})}
                 class="reveal group block rounded-2xl bg-surface overflow-hidden border border-white/5">
              <img src={p.image} alt={p.alt ?? p.title} width="1280" height="696" loading="lazy" decoding="async"
                   class="aspect-[16/9] w-full object-cover object-top transition-transform duration-500 group-hover:scale-105" />
              <div class="p-5">
                <p class="text-xs uppercase tracking-wider text-accent">{p.category}</p>
                <h3 class="mt-1 text-xl font-medium">{p.title}</h3>
                <p class="mt-2 text-sm text-muted">{p.text}</p>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {p.tags.map((t) => <li class="rounded-full border border-white/10 px-3 py-1 text-xs text-muted">{t}</li>)}
                </ul>
              </div>
            </Tag>
          );
        })}
      </div>
    </section>

    <section id="services" class="mx-auto max-w-6xl px-5 py-20">
      <h2 class="text-3xl font-semibold mb-10">Services</h2>
      <div class="grid gap-6 md:grid-cols-3">
        {services.map((s) => (
          <div class="reveal rounded-2xl bg-surface p-6 border border-white/5">
            <h3 class="text-xl font-medium">{s.title}</h3>
            <p class="mt-2 text-muted">{s.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="contact" class="mx-auto max-w-3xl px-5 py-24 text-center">
      <h2 class="reveal text-4xl font-semibold">Let's build something great</h2>
      <p class="reveal mt-4 text-muted">Tell me about your project. Book a quick call, or DM me on X or email if you prefer.</p>
      <div class="reveal mt-8 flex justify-center flex-wrap gap-4">
        <a href={site.booking} target="_blank" rel="noopener" class="rounded-full bg-accent px-6 py-3 font-medium text-bg hover:opacity-90">Book a 15-min call</a>
        <a href={site.x} target="_blank" rel="noopener" class="rounded-full border border-white/15 px-6 py-3 hover:bg-white/5">DM {site.xHandle} on X</a>
        <a href={site.x} data-u={site.emailUser} data-d={site.emailDomain} class="email-btn rounded-full border border-white/15 px-6 py-3 hover:bg-white/5">Email me</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script>
  // Builds the mailto link on click so scrapers can't read the address from the HTML.
  document.querySelectorAll<HTMLAnchorElement>('.email-btn').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      location.href = `mailto:${a.dataset.u}@${a.dataset.d}`;
    });
  });
</script>
