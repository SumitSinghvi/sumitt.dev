---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Page not found">
  <Header />
  <main class="mx-auto max-w-3xl px-5 py-32 text-center">
    <h1 class="text-5xl font-bold">404</h1>
    <p class="mt-4 text-muted">That page doesn't exist.</p>
    <a href="/" class="mt-8 inline-block rounded-full bg-ink px-6 py-3 font-medium text-white">Back home</a>
  </main>
  <Footer />
</Base>
