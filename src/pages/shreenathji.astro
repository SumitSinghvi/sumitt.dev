---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import OrdersMock from '../components/OrdersMock.astro';
import { contactLink, contactLabel } from '../data/site';
const stories = [
  {
    title: 'Challans that match on web and Android',
    text: 'The Android app must work offline, so it cannot rely on a server-side PDF. I built two renderers: the web print slip and an Android Canvas PdfDocument. Both follow one pagination rule, mirrored in challanPagination.ts and ChallanPagination.kt, and are locked together by 10 shared fixture orders, a sync script and a ChallanFixturesTest, so the two outputs cannot drift apart.',
  },
  {
    title: 'Offline-first orders',
    text: 'Salespeople work inside multi-storey markets with poor signal. Orders created offline can still be printed and shared as challans, then sync to the server when the connection returns.',
  },
  {
    title: 'Licence-based access, tied to the device',
    text: 'Every role uses licence-based access that is bound to the device, so an account cannot simply be copied to another phone.',
  },
  {
    title: 'Live field tracking',
    text: 'Background GPS in the Android app feeds a live map for managers, with market territories drawn as polygons and a party directory that learns each client\'s location.',
  },
];
const features = [
  'Offline-first order taking with a sync engine',
  'PDF challans to print or share on WhatsApp',
  'Live GPS map and market territories',
  'Order pipeline with approve / reject and billing',
  'Daily beat planner and party directory',
  'Fabric catalog',
  'Over-the-air app updates',
  'Supabase backend: Postgres, storage, row-level security, webhooks, CI/CD',
];
---
<Base title="Shreenathji Textile case study — Sumitt.dev" description="A field sales and order system for textile wholesalers: offline-first Android app, manager dashboard, live GPS and printable challans.">
  <Header />
  <main class="mx-auto max-w-4xl px-5 py-16">
    <p class="text-sm uppercase tracking-widest text-accent">Case study</p>
    <h1 class="mt-3 text-4xl md:text-5xl font-bold tracking-tight">Shreenathji Textile</h1>
    <p class="mt-5 text-lg text-muted">Field sales and order system for textile wholesalers: a native Android app that works offline, plus a web dashboard for managers, backed by Supabase.</p>

    <div class="mt-10 rounded-2xl overflow-hidden border border-white/10 aspect-[16/9]"><OrdersMock /></div>

    <h2 class="mt-16 text-2xl font-semibold">The problem</h2>
    <p class="mt-3 text-muted">Wholesalers and agents in the Surat and Ahmedabad markets (RKTM, Millennium, Regent) work inside multi-storey buildings with poor signal. Salespeople need to plan their beat visits, take orders and print challans on the spot, and managers need to know where the team is.</p>

    <h2 class="mt-12 text-2xl font-semibold">What it does</h2>
    <ul class="mt-4 grid gap-2 text-muted">
      {features.map((f) => <li class="flex gap-2"><span class="text-accent">✓</span>{f}</li>)}
    </ul>

    <h2 class="mt-12 text-2xl font-semibold">Engineering notes</h2>
    <div class="mt-6 grid gap-5">
      {stories.map((s) => (
        <div class="rounded-2xl bg-surface p-6 border border-white/5">
          <h3 class="text-lg font-medium">{s.title}</h3>
          <p class="mt-2 text-muted">{s.text}</p>
        </div>
      ))}
    </div>

    <h2 class="mt-12 text-2xl font-semibold">Stack</h2>
    <ul class="mt-4 flex flex-wrap gap-2">
      {['Android (Kotlin)', 'TypeScript', 'Supabase', 'Postgres'].map((t) => <li class="rounded-full border border-white/10 px-3 py-1 text-sm text-muted">{t}</li>)}
    </ul>
    <p class="mt-6 text-xs text-muted">The interface shown above is an illustration drawn with sample data. No client information is displayed.</p>

    <div class="mt-16 rounded-2xl border border-accent p-8 text-center">
      <h2 class="text-2xl font-semibold">Want this for your business?</h2>
      <p class="mt-2 text-muted">I can set up the same system for your parties, fabrics and challan format.</p>
      <a href={contactLink} target="_blank" rel="noopener" class="mt-6 inline-block rounded-full bg-accent px-6 py-3 font-semibold text-bg hover:opacity-90">{contactLabel}</a>
    </div>
  </main>
  <Footer />
</Base>
